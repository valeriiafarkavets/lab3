<Window x:Class="lab3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:lab3"
        Title="Лабораторна робота №3 - Інтерполяція даних" 
        Height="450" Width="780"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Параметри" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Крок опорних точок (h1):"/>
            <TextBox Text="{Binding H1}" Margin="0,2,0,10"/>
            <TextBox Text="{Binding H2}" Margin="0,2,0,10"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Separator Margin="0,5,0,10"/>
            <TextBlock Text="Відображення" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
            <CheckBox Content="Еталонна sin(x)" IsChecked="{Binding ShowExact}" Foreground="Black" Margin="0,3"/>
            <CheckBox Content="Лінійна (Червоний)" IsChecked="{Binding ShowLinear}" Foreground="Red" Margin="0,3"/>
            <CheckBox Content="Ерміта (Синій)" IsChecked="{Binding ShowHermite}" Foreground="Blue" Margin="0,3"/>
            <Separator Margin="0,10,0,10"/>
            <CheckBox Content="Графік похибки" IsChecked="{Binding ShowError}" FontWeight="SemiBold" Margin="0,3"/>
        </StackPanel>
        <Border Grid.Column="1" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5">
            <Canvas Width="500" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Line X1="10" Y1="150" X2="490" Y2="150" Stroke="Gray" StrokeDashArray="2 2"/>
                <Polyline Points="{Binding ExactPoints}" 
                          Stroke="Black" StrokeThickness="1.5"
                          Visibility="{Binding ShowExact, Converter={StaticResource BoolToVis}}"/>
                <Polyline Points="{Binding LinearPoints}" 
                          Stroke="Red" StrokeThickness="2"
                          Visibility="{Binding ShowLinear, Converter={StaticResource BoolToVis}}"/>
                <Polyline Points="{Binding HermitePoints}" 
                          Stroke="Blue" StrokeThickness="2"
                          Visibility="{Binding ShowHermite, Converter={StaticResource BoolToVis}}"/>
            </Canvas>
        </Border>
    </Grid>
</Window>